{
  "name": "twitch-botifier",
  "version": "1.0.0",
  "description": "A bot that notifies you when a streamer goes live",
  "main": "build/index.js",
  "scripts": {
    "build": "npm run clearAndCopy && tsc && echo 🛫 Successfully builded an app!\n",
    "start": "node build/index.js",
    "buildRun": "npm run build && npm run start",
    "clearAndCopy": "node -e \"const{rmSync,mkdirSync,readdirSync,copyFileSync}=require('fs'),s='src/server/static',d='build/server/static';rmSync('build/server',{recursive:true,force:true});mkdirSync(d,{recursive:true});for(const f of readdirSync(s))copyFileSync(s+'/'+f,d+'/'+f)\""
  },
  "author": "richardscull",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "axios": "^1.20.0",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "mongoose": "^8.24.4",
    "node-telegram-bot-api": "^0.67.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "node-telegram-bot-api": {
      "@cypress/request": "^4.0.1"
    },
    "request": "npm:@cypress/request@^4.0.1",
    "form-data": "^4.0.6"
  }
}
